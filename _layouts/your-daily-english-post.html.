---
layout: default
---

{% assign series_id = "your-daily-english" %}
{% assign total_days = 365 %}

{% assign series_posts = site.posts
| where: "series", series_id
| sort: "date"
%}

<!-- ============================================================
     CALCOLO GIORNO CORRENTE
     ============================================================ -->{% assign current_day = 0 %}
{% assign current_index = -1 %}

{% for series_post in series_posts %}

{% if series_post.url == page.url %}

{% assign current_day = forloop.index %}
{% assign current_index = forloop.index0 %}

{% endif %}

{% endfor %}

<!-- ============================================================
     ARTICOLO PRECEDENTE
     ============================================================ -->{% assign previous_post = nil %}

{% if current_index > 0 %}

{% assign previous_index = current_index | minus: 1 %}
{% assign previous_post = series_posts[previous_index] %}

{% endif %}

<!-- ============================================================
     ARTICOLO SUCCESSIVO
     ============================================================ -->{% assign next_post = nil %}
{% assign next_index = current_index | plus: 1 %}

{% if next_index < series_posts.size %}

{% assign next_post = series_posts[next_index] %}

{% endif %}

<!-- ============================================================
     PROGRESSO
     ============================================================ -->{% assign progress = 0 %}

{% if current_day > 0 %}

{% assign progress = current_day
| times: 100.0
| divided_by: total_days
%}

{% endif %}

<!-- ============================================================
     BREADCRUMB
     ============================================================ --><nav
  class="breadcrumbs yde-breadcrumbs"
  aria-label="Breadcrumb"
>  <a href="{{ site.data.site.urls.home | relative_url }}">
    Home
  </a>  <span aria-hidden="true">
    →
  </span>  <a href="{{ site.data.site.urls.series | relative_url }}">
    Serie
  </a>  <span aria-hidden="true">
    →
  </span>  <a href="{{ '/serie/your-daily-english/' | relative_url }}">
    Your Daily English
  </a>{% if current_day > 0 %}

<span aria-hidden="true">
  →
</span>

<span>
  Giorno {{ current_day }}
</span>

{% endif %}

</nav><!-- ============================================================
     HERO
     ============================================================ --><section class="yde-post-hero">  <div class="container article-container"><div class="yde-post-meta">

  <a
    href="{{ '/serie/your-daily-english/' | relative_url }}"
    class="article-series"
  >
    Your Daily English
  </a>

  {% if current_day > 0 %}

    <span class="yde-day">
      Giorno {{ current_day }} di {{ total_days }}
    </span>

  {% endif %}

</div>


<h1>
  {{ page.title }}
</h1>


{% if page.description %}

  <p class="article-description">
    {{ page.description }}
  </p>

{% endif %}


{% if current_day > 0 %}

  <div class="yde-progress">

    <div class="yde-progress-header">

      <span>
        Il tuo percorso
      </span>

      <strong>
        {{ current_day }} / {{ total_days }}
      </strong>

    </div>


    <div
      class="yde-progress-bar"
      role="progressbar"
      aria-valuenow="{{ current_day }}"
      aria-valuemin="0"
      aria-valuemax="{{ total_days }}"
      aria-label="Giorno {{ current_day }} di {{ total_days }}"
    >

      <div
        class="yde-progress-fill"
        style="width: {{ progress }}%;"
      ></div>

    </div>

  </div>

{% endif %}

  </div></section><!-- ============================================================
     CONTENUTO ARTICOLO
     ============================================================ --><article class="article yde-article">  <div class="container article-container"><div class="article-content">

  {{ content }}

</div>


<!-- ========================================================
     FOOTER ARTICOLO
     ======================================================== -->

<footer class="article-footer yde-article-footer">


  <!-- ======================================================
       TAG
       ====================================================== -->

  {% if page.tags %}

    <div class="article-tags">

      {% for tag in page.tags %}

        <span class="tag">
          {{ tag }}
        </span>

      {% endfor %}

    </div>

  {% endif %}


  <!-- ======================================================
       NAVIGAZIONE DELLA SERIE
       ====================================================== -->

  <nav
    class="yde-day-navigation"
    aria-label="Navigazione Your Daily English"
  >


    <!-- ====================================================
         GIORNO PRECEDENTE
         ==================================================== -->

    {% if previous_post %}

      <a
        href="{{ previous_post.url | relative_url }}"
        class="yde-day-nav yde-day-prev"
      >

        <span class="yde-day-nav-label">
          ← Giorno precedente
        </span>

        <strong>
          Giorno {{ current_day | minus: 1 }}
        </strong>

        <span>
          {{ previous_post.title }}
        </span>

      </a>

    {% else %}

      <div class="yde-day-nav yde-day-placeholder">

        <span class="yde-day-nav-label">
          INIZIO DEL PERCORSO
        </span>

        <strong>
          Giorno 1
        </strong>

        <span>
          Sei all'inizio di Your Daily English
        </span>

      </div>

    {% endif %}


    <!-- ====================================================
         HOME SERIE
         ==================================================== -->

    <a
      href="{{ '/serie/your-daily-english/' | relative_url }}"
      class="yde-day-nav yde-day-home"
    >

      <span class="yde-day-nav-label">
        Percorso
      </span>

      <strong>
        {{ current_day }} / {{ total_days }}
      </strong>

      <span>
        Your Daily English
      </span>

    </a>


    <!-- ====================================================
         GIORNO SUCCESSIVO
         ==================================================== -->

    {% if next_post %}

      <a
        href="{{ next_post.url | relative_url }}"
        class="yde-day-nav yde-day-next"
      >

        <span class="yde-day-nav-label">
          Giorno successivo →
        </span>

        <strong>
          Giorno {{ current_day | plus: 1 }}
        </strong>

        <span>
          {{ next_post.title }}
        </span>

      </a>

    {% else %}

      <div class="yde-day-nav yde-day-placeholder">

        {% if current_day == total_days %}

          <span class="yde-day-nav-label">
            FINE DEL PERCORSO
          </span>

          <strong>
            Giorno {{ total_days }}
          </strong>

          <span>
            Hai completato Your Daily English
          </span>

        {% else %}

          <span class="yde-day-nav-label">
            PROSSIMO GIORNO
          </span>

          <strong>
            Giorno {{ current_day | plus: 1 }}
          </strong>

          <span>
            Nuovo contenuto in arrivo
          </span>

        {% endif %}

      </div>

    {% endif %}

  </nav>

</footer>

  </div></article><!-- ============================================================
     PROSSIMO PASSO
     ============================================================ -->{% if next_post %}

  <section class="yde-next"><div class="container">

  <div class="yde-next-box">

    <span class="section-label">
      PROSSIMO PASSO
    </span>

    <h2>
      Continua domani
    </h2>

    <p>
      Hai completato il Giorno {{ current_day }}.
      Continua il percorso con il prossimo piccolo passo.
    </p>

    <a
      href="{{ next_post.url | relative_url }}"
      class="button button-primary"
    >
      Vai al Giorno {{ current_day | plus: 1 }} →
    </a>

  </div>

</div>

  </section>{% elsif current_day == total_days %}

  <section class="yde-next"><div class="container">

  <div class="yde-next-box">

    <span class="section-label">
      PERCORSO COMPLETATO
    </span>

    <h2>
      Hai completato Your Daily English
    </h2>

    <p>
      Hai completato tutti i 365 giorni del percorso.
    </p>

    <a
      href="{{ '/serie/your-daily-english/' | relative_url }}"
      class="button button-primary"
    >
      Torna alla serie
    </a>

  </div>

</div>

  </section>{% elsif current_day > 0 %}

  <section class="yde-next"><div class="container">

  <div class="yde-next-box">

    <span class="section-label">
      PROSSIMO PASSO
    </span>

    <h2>
      Continua il percorso
    </h2>

    <p>
      Il prossimo giorno di Your Daily English
      sarà disponibile presto.
    </p>

    <a
      href="{{ '/serie/your-daily-english/' | relative_url }}"
      class="button button-primary"
    >
      Esplora la serie
    </a>

  </div>

</div>

  </section>{% endif %}

<!-- ============================================================
     CTA
     ============================================================ -->{% include cta.html %}
